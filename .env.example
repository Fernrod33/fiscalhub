# Configuração do compose.yaml (produção). Copie para .env no servidor (chmod 600) e preencha.
# Nunca versione o .env. Segredos fortes: openssl rand -base64 48 (ou 32 para as chaves do MinIO).
# Os demais ajustes de produção estão no perfil prod (backend/src/main/resources/application-prod.properties).

# Domínio público (o Caddy emite o certificado TLS para ele) e o e-mail dos avisos do Let's Encrypt
DOMINIO=fiscalhub.exemplo.com.br
ACME_EMAIL=

# PostgreSQL
DB_PASSWORD=

# Assinatura das sessões (JWT), mínimo 32 bytes
JWT_SECRET=
# Cifra AES-256 do segredo do segundo fator (TOTP): exatamente 32 bytes (openssl rand -base64 32). Trocá-la invalida
# os segundos fatores já ativos (cada usuário ativa de novo)
CHAVE_DADOS=
# Minutos sem requisição até a sessão expirar (além da expiração absoluta de 24 h)
SESSAO_INATIVIDADE_MINUTOS=30

# MinIO: administrador (só o minio-init usa), usuário da aplicação (só o bucket) e chave do SSE-S3
MINIO_ROOT_USER=fiscalhub-admin
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=fiscalhub-app
S3_SECRET_KEY=
# formato nome:base64-de-32-bytes, ex.: fiscalhub-sse:$(openssl rand -base64 32)
MINIO_KMS_SECRET_KEY=
# S3_BUCKET=fiscalhub-documentos

# Limite único de upload, em MB: o mesmo valor vai para o proxy, o Spring e a tela
UPLOAD_MAX_SIZE_MB=500

# Id(s) de usuário de quem mantém o sistema (crie a conta antes; SELECT id FROM usuario WHERE email = ...): alertas de
# edital perto do fim e métricas de layouts sem leitura. Não é e-mail: o cadastro é aberto e o e-mail não é verificado
ADMIN_SISTEMA=

# Opcionais
# BACKEND_MEMORIA=2g
# DB_POOL_MAXIMO=15
# INDICES_AGENDAMENTO=true
# VERSAO=local
