# Configuração do compose.yaml (produção). Copie para .env no servidor (chmod 600) e preencha.
# Nunca versione o .env. Segredos fortes: openssl rand -base64 48 (ou 32 para as chaves do MinIO).
# Os demais ajustes de produção estão no perfil prod (backend/src/main/resources/application-prod.properties).

# Domínio público, sem https:// (o Caddy emite o certificado TLS para ele; o remetente do e-mail e a ORIGEM_PUBLICA
# derivam dele) e o e-mail dos avisos do Let's Encrypt. O compose não sobe sem DOMINIO.
DOMINIO=
ACME_EMAIL=

# PostgreSQL
DB_PASSWORD=
# papel da aplicação no banco (fiscalhub_app); diferente da DB_PASSWORD e sem aspas simples: openssl rand -hex 24
DB_APP_PASSWORD=

# Assinatura das sessões (JWT), mínimo 32 bytes
JWT_SECRET=
# Cifra AES-256 do segredo do segundo fator (TOTP): exatamente 32 bytes (openssl rand -base64 32). Trocá-la invalida
# os segundos fatores já ativos (cada usuário ativa de novo)
CHAVE_DADOS=
# Minutos sem requisição até a sessão expirar (além da expiração absoluta de 24 h)
SESSAO_INATIVIDADE_MINUTOS=30
# Anos de guarda da trilha de auditoria; o job diário expurga o que for mais antigo. Padrão 5 (decadência e prescrição,
# CTN arts. 173 e 174). PRAZO FINAL A VALIDAR COM O JURÍDICO (ver docs/lgpd/inventario.md)
AUDITORIA_RETENCAO_ANOS=5

# MinIO: administrador (só o minio-init usa), usuário da aplicação (só o bucket) e chave do SSE-S3
MINIO_ROOT_USER=fiscalhub-admin
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=fiscalhub-app
S3_SECRET_KEY=
# formato nome:base64-de-32-bytes, ex.: fiscalhub-sse:$(openssl rand -base64 32)
MINIO_KMS_SECRET_KEY=
# S3_BUCKET=fiscalhub-documentos

# Limite único de upload, em MB: o mesmo valor vai para o proxy, o Spring e a tela
UPLOAD_MAX_SIZE_MB=500

# Id(s) de usuário de quem mantém o sistema (crie a conta antes; SELECT id FROM usuario WHERE email = ...): alertas de
# edital perto do fim e métricas de layouts sem leitura. Não é e-mail: o cadastro é aberto e o e-mail não é verificado
ADMIN_SISTEMA=

# E-mail transacional: Amazon SES (sa-east-1) pela interface SMTP. Passo a passo em docs/deploy/email-ses.md.
# Usuário e senha são as CREDENCIAIS SMTP do SES (IAM > usuário só com ses:SendRawEmail), não a chave de acesso da conta
SMTP_USUARIO=
SMTP_SENHA=
# Remetente num domínio verificado no SES (padrão: FiscalHub <nao-responda@DOMINIO>)
# EMAIL_REMETENTE=FiscalHub <nao-responda@DOMINIO>
# SMTP_HOST=email-smtp.sa-east-1.amazonaws.com

# Backup (deploy/backup.sh; passo a passo em docs/deploy/hostinger.md). A chave PÚBLICA do age (age1...): a privada
# nunca vem para o servidor
BACKUP_AGE_DESTINATARIO=
# Bucket S3 externo (sa-east-1, versionado, Object Lock governance 35 dias) e a credencial IAM só com s3:PutObject nele.
# A credencial de leitura fica fora do servidor
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGIAO=sa-east-1
# BACKUP_DIR=/var/backups/fiscalhub
# BACKUP_RETER_DIARIO=7
# BACKUP_RETER_SEMANAL=4
# BACKUP_RETER_MENSAL=6

# Opcionais
# BACKEND_MEMORIA=2g
# DB_POOL_MAXIMO=15
# INDICES_AGENDAMENTO=true
# VERSAO=local
