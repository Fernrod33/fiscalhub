{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBackups",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::NOME_DO_BUCKET"
    },
    {
      "Sid": "BaixarBackups",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::NOME_DO_BUCKET/*"
    }
  ]
}
