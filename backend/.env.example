# Copie para backend/.env e preencha. O .env nao e versionado.

# Obrigatorias
DB_PASSWORD=
# Minimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=

# Opcionais (valor padrao entre parenteses)
# DB_URL=jdbc:postgresql://localhost:5432/fiscalhub
# DB_USERNAME=postgres
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# Cookie da sessão com Secure (padrão true; o perfil dev desliga)
# COOKIE_SECURE=true
# UPLOAD_MAX_SIZE=500MB

# Storage: local (padrao) ou s3 (S3/MinIO; o bucket precisa existir)
# STORAGE_TIPO=local
# STORAGE_LOCAL_DIRETORIO=./uploads/documentos
# S3_ENDPOINT=http://localhost:9000
# S3_REGIAO=us-east-1
# S3_BUCKET=fiscalhub-documentos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Importacao diaria da SELIC do Banco Central (true)
# SELIC_AGENDAMENTO=true
