<?xml version="1.0" encoding="UTF-8"?>
<!-- O padrão do Spring Boot, com a máscara de CNPJ, CPF e valores (operacao/MascaraLog) na mensagem e no stack trace.
     Perfil prod: JSON estruturado (logging.structured.format.console), mascarado pelo MascaraLog.Json. -->
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<conversionRule conversionWord="m" class="com.fiscalhub.backend.operacao.MascaraLog$Mensagem"/>
	<conversionRule conversionWord="wEx" class="com.fiscalhub.backend.operacao.MascaraLog$Excecao"/>
	<springProfile name="prod">
		<include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>
	</springProfile>
	<springProfile name="!prod">
		<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
	</springProfile>
	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
	</root>
</configuration>
